# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados (Drizzle / MySQL)
# Aceita formato: mysql://user:pass@host:port/db
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://root:CHANGEME@localhost:3306/portfolio

# ─────────────────────────────────────────────────────────────────────────────
# Auth — segredo de assinatura dos JWT de sessão (mínimo 32 chars aleatórios)
# Gere com: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGEME_minimum_32_chars_random_string

# ─────────────────────────────────────────────────────────────────────────────
# Admin allowlist por IP (CSV). Ex: ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
#
# EM PRODUÇÃO ISTO É OBRIGATÓRIO: a regra falha FECHADO. Com a lista vazia,
# /admin e /login respondem 404 para todo mundo, inclusive para você — e IP que
# o servidor não consegue identificar também é negado.
# Em desenvolvimento, localhost passa sem precisar de lista.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_ALLOWED_IPS=

# ─────────────────────────────────────────────────────────────────────────────
# OWNER_OPEN_ID — openId que recebe role=admin automaticamente após OAuth
# ─────────────────────────────────────────────────────────────────────────────
OWNER_OPEN_ID=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub — usado SOMENTE se você ressuscitar a página /github (hoje redireciona
# pro perfil externo). Token opcional pra aumentar o rate-limit do API público.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_USERNAME=vitordsb
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OAuth (Manus / portal externo)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_OAUTH_PORTAL_URL=
NEXT_PUBLIC_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Orçamento com IA (/orcamento): DeepSeek, API no formato OpenAI.
# Sem a chave, em produção a página avisa "indisponível" e manda pro WhatsApp;
# em dev, responde com um roteiro simulado pra testar a tela.
# As métricas de preço ficam em lib/estimate/pricing.ts (não na IA).
# ─────────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────────────────────
# Pagamentos (Asaas). Sandbox: chave $aact_hmlg_...; produção: $aact_prod_...
# O ambiente (sandbox ou produção) é escolhido pelo prefixo da chave.
# No .env.local, escape o cifrão: ASAAS_API_KEY=\$aact_hmlg_...
# Na Vercel, cole a chave como está (sem barra).
# ASAAS_WEBHOOK_TOKEN: segredo de 32+ caracteres que o Asaas manda no header
# asaas-access-token (configurado junto com o webhook no painel do Asaas).
# ─────────────────────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Quem recebe os avisos do site (orçamento, Raio-X, contato, pagamento).
# Vários separados por vírgula. Vazio = vitordsb2019@gmail.com e vantywork@gmail.com.
CONTACT_TO_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Depoimentos (/depoimento). Ficam no Vercel Blob: ligue um store PÚBLICO no
# projeto (Storage > Blob) e a Vercel cria BLOB_READ_WRITE_TOKEN sozinha.
# Sem o Blob, a página de depoimento avisa "fora do ar" e a seção some da home.
# TESTIMONIAL_SECRET assina o link único (pnpm depoimento) e o botão "Tirar do
# site" do e-mail. 32+ caracteres, o MESMO valor aqui e na Vercel.
# Gere com: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
TESTIMONIAL_SECRET=
